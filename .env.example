# Used by the browser (client components) — must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Used only on the server (SSR data fetching, sitemap generation) — no prefix needed,
# can point at an internal URL if your backend has one, otherwise same as above
API_URL=http://localhost:5000/api

# The canonical public site URL — used in sitemap.xml, robots.txt, and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
